{
  "schemaVersion": 1,
  "id": "comate-run-log-dumper",
  "version": "1.0.0",
  "displayName": "Comate 运行过程日志落盘",
  "description": "Record the full lifecycle of a Comate run into Documents/WPSComate/logs/<runId>.log.",
  "targets": ["desktop"],
  "engines": { "agentSdk": "^1.0.15" },
  "contributes": {
    "extensions": [
      {
        "id": "comate-run-lifecycle-logger",
        "entry": "./dist/extension.js",
        "optional": false,
        "agents": "*",
        "targets": ["desktop"]
      }
    ]
  }
}
