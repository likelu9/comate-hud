{
  "schema": "wps-design-manifest/1",
  "version": "1.4",
  "project": "ComateHUD",
  "product": "Comate HUD 官网",
  "artifact": {
    "type": "静态单页官网",
    "stack": "单文件 index.html（HTML + <style> + 原生 JS，无框架无构建）",
    "source": "ComateHUD/index.html",
    "line_count_at_spec_time": 1308,
    "sections_before": 13,
    "sections_after": 12
  },
  "style": {
    "name": "minimal-dark-macos",
    "mode": "dark",
    "principles": [
      "留白层级代替分隔线：不加 section 边框 / 不加背景分区 / 不加装饰图形",
      "唯一 accent 只作点睛，不做运营大促感",
      "零外部资源，图标一律手写内联 SVG",
      "信息密度下降，信息量不变"
    ]
  },
  "design_docs": {
    "hub": "docs/designs/DESIGN.md",
    "sections": [
      {
        "id": "appstats",
        "title": "应用统计区块",
        "scope": "#appstats 区块（位于 #versions 与 #wishwall 之间）",
        "status": "已实现"
      },
      {
        "id": "download",
        "title": "下载区块",
        "scope": "hero 内 #download（公共信息行 / MAC·WIN·GitHub 三按钮 / 按钮外体积元信息行 / macOS 安装说明 hover 气泡）",
        "status": "已实现"
      },
      {
        "id": "copy-spacing",
        "title": "全站文案精简 + 排版节奏",
        "scope": "全站文案（#download 内部除外）+ 全站区块 padding / 网格 gap / 卡片内边距 / 字号行高；删除 #how（13 → 12 区块）；#compat 表格 → 一行标签带",
        "status": "待实现",
        "key_decisions": [
          "features 不扩成 9 张卡：how-section 的 3 步 9 句中 8 句与其他区块重复，唯一有效句并入「实时状态灯」卡",
          "#compat 保留 section 与 id（导航/页脚锚点），但 top padding 归零，读作 #tech 的规格脚注",
          "区块间距从「一律 160px」拆成 112 / 168 / 192 / 208 / 224 / 240 三档节奏"
        ]
      }
    ]
  },
  "tokens": {
    "colors": {
      "bg": "#0a0a0f",
      "bgCard": "#111118",
      "bgCardHover": "#16161f",
      "text": "#f5f5f7",
