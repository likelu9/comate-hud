{
  "version": "003_create_app_activity",
  "description": "创建应用活跃表：每用户每天一行（活跃日期、用户名+uid、版本号、设备标识、启动/hover/点击计数）。成员可创建、可读、可更新自己的行；删除仅限管理员，防止误删统计",
  "operations": [
    {
      "type": "schema",
      "action": "create_table",
      "table": "app_activity",
      "params": {
        "columns": [
          { "name": "uid", "type": "text", "length": 32, "required": true },
          { "name": "user_name", "type": "text", "length": 64 },
          { "name": "version", "type": "text", "length": 32 },
          { "name": "active_day", "type": "text", "length": 8, "required": true },
          { "name": "first_active_at", "type": "text", "length": 32 },
          { "name": "launch_count", "type": "number" },
          { "name": "hover_count", "type": "number" },
          { "name": "click_count", "type": "number" },
          { "name": "device_id", "type": "text", "length": 64 },
          { "name": "os_version", "type": "text", "length": 64 }
        ]
      },
      "access": {
        "pattern": "custom",
        "default_role": "member",
        "rules": {
          "create": { "effect": "allow" },
          "read": { "effect": "allow" },
          "update": { "effect": "allow", "condition": "create_id=$USER" },
          "delete": { "effect": "deny" }
        }
      }
    },
    {
      "type": "data",
      "action": "insert",
      "table": "app_activity",
      "params": {
        "rows": [
          {
            "uid": "1388246874",
            "user_name": "李柯陆",
            "version": "0.0.0",
            "active_day": "20250101",
            "first_active_at": "2025-01-01T00:00:00+08:00",
            "launch_count": 0,
            "hover_count": 0,
            "click_count": 0,
            "device_id": "seed-row",
            "os_version": "-"
          }
        ]
      }
    }
  ]
}
